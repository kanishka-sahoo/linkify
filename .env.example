# Neon Postgres connection string
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Auth
BETTER_AUTH_SECRET=generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# One-time first-run authorization; generate with: openssl rand -base64 48
SETUP_SECRET=generate-a-unique-secret-with-at-least-32-characters
# Header set and sanitized by the deployment proxy
TRUSTED_IP_HEADER=x-real-ip

# Public base URL used to build short links (no trailing slash)
APP_BASE_URL=http://localhost:3000

# Optional separate HMAC secret for pseudonymous unique-visitor counting.
# BETTER_AUTH_SECRET is used when this is unset.
ANALYTICS_HASH_SECRET=

# Passkey relying-party display name
PASSKEY_RP_NAME=Linkify

# Maintenance and retention
CRON_SECRET=generate-another-long-random-string
ANALYTICS_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
